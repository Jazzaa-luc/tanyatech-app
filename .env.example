# Copy this file to .env and fill in your own values

PORT=3000

# Password for the admin dashboard (change this!)
ADMIN_PASSWORD=changeme123

# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET=please-change-this-to-a-long-random-string

# WhatsApp number that receives orders and custom requests, digits only,
# in international format WITHOUT the leading + (e.g. Jordan: 9627xxxxxxxx)
ADMIN_WHATSAPP=962790000000

# CliQ alias customers should pay to
CLIQ_ALIAS=TANYATECH3D

# Minimum order total in JD
MIN_ORDER_JD=10
